- 	}
- 	if (npages > 1) {
- 		/* for decoding across pages */
--		args.acl_scratch = alloc_page(GFP_KERNEL);
--		if (!args.acl_scratch)
-+		res.acl_scratch = alloc_page(GFP_KERNEL);
-+		if (!res.acl_scratch)
- 			goto out_free;
- 	}
- 	args.acl_len = npages * PAGE_SIZE;
-@@ -3605,8 +3605,8 @@ out_free:
- 	for (i = 0; i < npages; i++)
- 		if (pages[i])
- 			__free_page(pages[i]);
--	if (args.acl_scratch)
--		__free_page(args.acl_scratch);
-+	if (res.acl_scratch)
