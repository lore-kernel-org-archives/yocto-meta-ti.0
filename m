-+		fmerr("Unable to read firmware(%s) content\n", fw_name);
-+		return ret;
-+	}
-+	fmdbg("Firmware(%s) length : %d bytes\n", fw_name, fw_entry->size);
-+
-+	fw_data = (void *)fw_entry->data;
-+	fw_len = fw_entry->size;
-+
-+	fw_header = (struct bts_header *)fw_data;
