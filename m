-+/* Start address alignment */
-+#define SG_AA(sg)	(IS_ALIGNED(sg->offset, sizeof(u32)))
-+/* SHA1 block size alignment */
-+#define SG_SA(sg)	(IS_ALIGNED(sg->length, SHA2_MD5_BLOCK_SIZE))
