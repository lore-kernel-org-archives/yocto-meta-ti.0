-+	 * we don't want and can't tolerate.  Although it might be
-+	 * friendlier not to borrow this thread context...
-+	 */
-+	local_irq_enable();
-+#endif
-+
-+	twl4030charger_presence_evt();
-+	power_supply_changed(&di->bat);
-+
-+	return IRQ_HANDLED;
-+}
