-+	struct isp_device *isp = to_isp_device(ccdc);
-+	unsigned long l3_ick = pipe->l3_ick;
-+	unsigned int max_div = isp->revision == ISP_REVISION_15_0 ? 64 : 8;
-+	unsigned int div = 0;
-+	u32 fmtcfg_vp;
