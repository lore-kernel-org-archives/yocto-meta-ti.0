-+++ b/arch/arm/mach-omap2/am33xx-smartreflex-class2.c
-@@ -0,0 +1,1055 @@
-+/*
-+ * SmartReflex Voltage Control driver
-+ *
-+ * Copyright (C) 2012 Texas Instruments, Inc. - http://www.ti.com/
-+ * Author: Greg Guyotte <gguyotte@ti.com> (modified for AM33xx)
