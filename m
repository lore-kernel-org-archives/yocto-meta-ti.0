-+static void ks8851_read_mac_addr(struct net_device *dev)
-+{
-+	struct ks8851_net *ks = netdev_priv(dev);
-+	int i;
-+
-+	mutex_lock(&ks->lock);
-+
-+	for (i = 0; i < ETH_ALEN; i++)
-+		dev->dev_addr[i] = ks8851_rdreg8(ks, KS_MAR(i));
-+
-+	mutex_unlock(&ks->lock);
