-+{
-+	if (countNum >= MV_CNTMR_MAX_COUNTER )
-+	{
-+
-+		mvOsPrintf(("mvCntmrLoad: Err. Illigal counter number \n"));
-+		return MV_BAD_PARAM;;
-+
-+	}
-+
-+	MV_REG_WRITE(CNTMR_RELOAD_REG(countNum),value);
-+	MV_REG_WRITE(CNTMR_VAL_REG(countNum),value);
-+
-+	return MV_OK;
-+}
