-+	struct isp_device *isp = to_isp_device(ccp2);
-+	const struct v4l2_mbus_framefmt *ofmt = &ccp2->formats[CCP2_PAD_SOURCE];
-+	unsigned long l3_ick = pipe->l3_ick;
