-+static gboolean
-+setcaps (GstBaseSink *bsink,
-+         GstCaps *vscapslist)
-+{
-+    GstOmapFbSink *self;
-+    GstStructure *structure;
-+
-+    gint width, height;
-+    struct omapfb_color_key color_key;
-+
-+    self = GST_OMAPFB_SINK (bsink);
