- 		register_cpu_notifier(&setup_broadcast_notifier);
- 	}
- 
-@@ -472,7 +472,7 @@ static int intel_idle_cpuidle_driver_init(void)
- 	}
- 
- 	if (auto_demotion_disable_flags)
--		smp_call_function(auto_demotion_disable, NULL, 1);
