-+		{
-+			pPciAgent->isExpRom = MV_FALSE;
-+		}
-+
-+		pPciAgent->expRomAddr =
-+			(pciData & PERBAR_BASE_MASK) >> PERBAR_BASE_OFFS;
-+
-+	}
-+
-+
-+	if (MV_TRUE == pPciAgent->isCapListSupport)
-+	{
-+		/* Read  PCI_CAPABILTY_LIST_POINTER */
