-+
-+	/* read control register */
-+	cntmrCtrl = MV_REG_READ(CNTMR_CTRL_REG);
-+
-+	/* enable counter\timer */
-+	if (cntmrCtrl & CTCR_ARM_TIMER_EN(countNum))
-+	{
-+		pCtrl->enable = MV_TRUE;
-+	}
-+	else
-+	{
-+		pCtrl->enable = MV_FALSE;
-+	}
-+
-+	/* counter mode */
