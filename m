+-				if (sym->st_shndx == SHN_ABS) {
++				if (shn_abs) {
+ 					if (is_reloc(S_ABS, symname))
+ 						break;
+ 					else if (!is_reloc(S_SEG, symname))
+@@ -597,7 +601,7 @@ static void walk_relocs(void (*visit)(Elf32_Rel *rel, Elf32_Sym *sym),
+ 
+ 			case R_386_32:
+ 				symname = sym_name(sym_strtab, sym);
