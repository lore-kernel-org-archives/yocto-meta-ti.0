-+	int i, bit;
-+	void *param_ptr;
-+
-+	for (i = 0; i < ARRAY_SIZE(update_attrs); i++) {
-+		attr = &update_attrs[i];
-+
-+		if (!(prev->update & attr->feature_bit))
-+			continue;
-+		bit = params->features & attr->feature_bit;
-+		if (bit) {
-+			if (attr->config) {
-+				__preview_get_ptrs(params, &param_ptr, NULL,
-+						      NULL, bit);
-+				attr->config(prev, param_ptr);
-+			}
