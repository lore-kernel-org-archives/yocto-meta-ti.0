-+/* In register I2C_CON, Bit 15 is the I2C enable bit */
-+#define I2C_EN					BIT(15)
-+#define OMAP2_I2C_CON_OFFSET			0x24
-+#define OMAP4_I2C_CON_OFFSET			0xA4
