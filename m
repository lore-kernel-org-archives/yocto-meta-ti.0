-+		       OMAP3_ISP_IOMEM_H3A, ISPH3A_AFCOEF0010);
-+	/* set AFCOEF1010 Register */
-+	isp_reg_writel(af->isp, conf->iir.coeff_set1[10],
-+		       OMAP3_ISP_IOMEM_H3A, ISPH3A_AFCOEF1010);
