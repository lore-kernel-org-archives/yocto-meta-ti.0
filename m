-+	reg = bank->base + OMAP4_GPIO_OE;
-+	l = __raw_readl(reg);
-+	if (is_input)
-+		l |= 1 << gpio;
-+	else
-+		l &= ~(1 << gpio);
-+	__raw_writel(l, reg);
