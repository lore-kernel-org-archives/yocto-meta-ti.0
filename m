-@@ -185,6 +185,11 @@ static inline int wait_for_user_access(struct davinci_mdio_data *data)
- 		__davinci_mdio_reset(data);
- 		return -EAGAIN;
- 	}
-+
-+	reg = __raw_readl(&regs->user[0].access);
-+	if ((reg & USERACCESS_GO) == 0)
-+		return 0;
-+
