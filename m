-+		return USB_STOR_TRANSPORT_ERROR;
-+
- 	cmnd[0] = 0xF0;
- 	cmnd[1] = 0x0E;
- 	cmnd[2] = (u8)(addr >> 8);
-@@ -519,7 +524,8 @@ static int __do_config_autodelink(struct us_data *us, u8 *data, u16 len)
- 	cmnd[4] = (u8)(len >> 8);
- 	cmnd[5] = (u8)len;
