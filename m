-+		/*Set IIR Filter1 Coefficients */
-+		coef = 0;
-+		coef |= conf->iir.coeff_set1[index];
-+		coef |= conf->iir.coeff_set1[index + 1] <<
-+			AF_COEF_SHIFT;
-+		isp_reg_writel(af->isp, coef, OMAP3_ISP_IOMEM_H3A,
-+			       base_coef_set1);
-+		base_coef_set1 += AFCOEF_OFFSET;
-+	}
