-+		((32 * sph + (source->width - 1) * 64 + 16) >> 8) + 7;
-+	unsigned int min_height =
-+		((32 * spv + (source->height - 1) * 64 + 16) >> 8) + 4;
-+	unsigned int max_width =
-+		((64 * sph + (source->width - 1) * 1024 + 32) >> 8) + 7;
-+	unsigned int max_height =
-+		((64 * spv + (source->height - 1) * 1024 + 32) >> 8) + 7;
