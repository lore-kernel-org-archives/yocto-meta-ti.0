-+		res = tps65910_rtc_read_u8(&rd_reg, TPS65910_REG_RTC_STATUS);
-+		rd_reg &= 0xC3;
-+		res = tps65910_rtc_write_u8(rd_reg, TPS65910_REG_RTC_STATUS);
