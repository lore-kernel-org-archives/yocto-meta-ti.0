-+    if (ioctl (fd, FBIOGET_VSCREENINFO, &self->varinfo))
-+    {
-+        close (fd);
-+        return FALSE;
-+    }
-+
-+    if (close (fd))
-+        return FALSE;
-+
-+    self->overlay_fd = open ("/dev/fb1", O_RDWR);
-+
-+    if (self->overlay_fd == -1)
-+        return FALSE;
