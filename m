-+			return MV_ERROR;
-+		}
-+	}
-+	else
-+	{
-+		MV_REG_BIT_RESET(TDM_WIN_CTRL_REG(winNum), TDM_WIN_ENABLE_MASK);
-+	}
-+	return MV_OK;
-+}
