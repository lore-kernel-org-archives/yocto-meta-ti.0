-+		   pAddrDecWin->addrWin.size);
-+	return MV_ERROR;
-+    }
-+
-+    decRegs.baseReg = 0;
-+    decRegs.sizeReg = 0;
-+
-+    if (MV_OK != mvCtrlAddrDecToReg(&(pAddrDecWin->addrWin),&decRegs))
-+    {
