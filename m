-+	       UART011_RTIS | UART011_RXIS, uap->port.membase + UART011_ICR);
-+
- 	/*
- 	 * Allocate the IRQ
- 	 */
-@@ -1414,10 +1418,6 @@ static int pl011_startup(struct uart_port *port)
