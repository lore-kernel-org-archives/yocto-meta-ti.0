-@@ -1554,6 +1554,9 @@ static void set_data_timeout(struct omap_hsmmc_host *host)
- 	/* Use the maximum timeout value allowed in the standard of 14 or 0xE */
- 	dto = 14;
- 
-+	/* Set dto to max value of 14 to avoid SD Card timeouts */
-+	dto = 14;
