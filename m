-+		WARN(1, KERN_ERR "sysfs: kobject %s without dirent\n",
-+			kobject_name(kobj));
-+		return -ENOENT;
-+	}
-+
- 	err = 0;
- 	if (!sysfs_ns_type(dir_sd))
- 		goto out;
