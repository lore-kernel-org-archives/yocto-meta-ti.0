-+static gboolean
-+start (GstBaseSink *bsink)
-+{
-+    GstOmapFbSink *self;
-+    int fd;
-+
-+    self = GST_OMAPFB_SINK (bsink);
-+
-+    fd = open ("/dev/fb0", O_RDWR);
