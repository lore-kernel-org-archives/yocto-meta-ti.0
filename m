> ++        struct am33xx_sr_sensor *sens =3D &sr->sen[srid];
> ++
> ++        for (i =3D 0; i < sens->no_of_opps; i++) {
> ++              /* Read nTarget value form EFUSE register*/
> ++              sens->opp_data[i].nvalue =3D readl(AM33XX_CTRL_REGADDR
> ++                      (sens->opp_data[i].efuse_offs)) & 0xFFFFFF;
> ++
> ++                /* validate nTarget value */
