-+	switch (enable) {
-+	case ISP_PIPELINE_STREAM_CONTINUOUS:
-+		if (ccdc->output & CCDC_OUTPUT_MEMORY)
-+			omap3isp_sbl_enable(isp, OMAP3_ISP_SBL_CCDC_WRITE);
