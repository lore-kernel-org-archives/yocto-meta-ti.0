--			dbg("Baud rate requested not supported by device");
--			baud = tty_termios_baud_rate(old_termios);
--		}
--	}
--	/* Report back the resulting baud rate */
--	tty_encode_baud_rate(tty, baud, baud);
-+
-+	if (tty->termios->c_ospeed != old_termios->c_ospeed)
