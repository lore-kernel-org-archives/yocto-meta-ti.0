-+*
-+* RETURN:
-+*       Actual frequancy.
-+*
-+*******************************************************************************/
-+MV_U32 mvTwsiInit(MV_U8 chanNum, MV_HZ frequancy, MV_U32 Tclk, MV_TWSI_ADDR *pTwsiAddr, MV_BOOL generalCallEnable)
