-+static GstStateChangeReturn
-+gst_omapfbsink_change_state (GstElement * element, GstStateChange transition)
-+{
-+    GstOmapFbSink *omapfbsink;
-+    GstStateChangeReturn ret = GST_STATE_CHANGE_SUCCESS;
-+    GstXContext *xcontext = NULL;
