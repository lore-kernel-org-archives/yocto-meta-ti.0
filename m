-+/*
-+static unsigned long read_p15_c0 (void)
-+*/
-+/* read co-processor 15, register #0 (ID register) */
-+static MV_U32 read_p15_c0 (void)
-+{
-+	MV_U32 value;
-+
-+	__asm__ __volatile__(
-+		"mrc	p15, 0, %0, c0, c0, 0   @ read control reg\n"
-+		: "=r" (value)
-+		:
-+		: "memory");
-+
-+	return value;
-+}
