-+++ b/fs/eventpoll.c
-@@ -988,6 +988,10 @@ static int path_count[PATH_ARR_SIZE];
- 
- static int path_count_inc(int nests)
- {
-+	/* Allow an arbitrary number of depth 1 paths */
-+	if (nests == 0)
-+		return 0;
-+
- 	if (++path_count[nests] > path_limits[nests])
- 		return -1;
- 	return 0;
