-+
-+    /* Parameter checking   */
-+    if (winNum >= MV_SDMMC_MAX_ADDR_DECODE_WIN)
-+    {
-+        mvOsPrintf("%s: ERR. Invalid win num %d\n",__FUNCTION__, winNum);
-+        return MV_BAD_PARAM;
