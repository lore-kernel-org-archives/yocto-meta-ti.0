-+	switch (code->pad) {
-+	case CCDC_PAD_SINK:
-+		if (code->index >= ARRAY_SIZE(ccdc_fmts))
-+			return -EINVAL;
-+
-+		code->code = ccdc_fmts[code->index];
-+		break;
-+
-+	case CCDC_PAD_SOURCE_OF:
-+	case CCDC_PAD_SOURCE_VP:
