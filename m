+ 		 IRQ_SPIBEI |	/* SPI bus error */	\
+ 		 IRQ_TXPSI |	/* TX process stop */	\
+@@ -903,6 +899,7 @@ static int ks8851_net_stop(struct net_device *dev)
+ 
+ 	/* stop any outstanding work */
