-+	else	/* disable counter\timer */
-+	{
-+		cntmrCtrl &= ~CTCR_ARM_TIMER_EN(countNum);
-+	}
-+
-+	if ( pCtrl->autoEnable ) /* Auto mode */
-+	{
-+		cntmrCtrl |= CTCR_ARM_TIMER_AUTO_EN(countNum);
-+
-+	}
-+	else	/* no auto mode */
-+	{
-+		cntmrCtrl &= ~CTCR_ARM_TIMER_AUTO_EN(countNum);
-+	}
-+
-+	MV_REG_WRITE(CNTMR_CTRL_REG,cntmrCtrl);
-+
-+	return MV_OK;
-+
-+}
