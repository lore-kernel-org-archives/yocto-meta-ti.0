-+                    break;
-+                case (8):
-+                    mvHeaderReg |= ETH_MVHDR_MHMASK_8_QUEUE;
-+                    break;
-+                default:
-+                    break;
-+            }
-+        }
-+    }
-+
-+    MV_REG_WRITE(ETH_PORT_MARVELL_HEADER_REG(port), mvHeaderReg);
-+
-+    return MV_OK;
-+}
