-+	switch (pad) {
-+	case CCP2_PAD_SINK:
-+		if (fmt->code != V4L2_MBUS_FMT_SGRBG10_DPCM8_1X8)
-+			fmt->code = V4L2_MBUS_FMT_SGRBG10_1X10;
