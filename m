-+{
-+    MV_DIMM_INFO dimmInfo;
-+
-+    DB(mvOsPrintf("Dram: mvDramBankInfoGet bank %d\n", bankNum));
-+    /* zero pBankInfo structure */
-+    memset(pBankInfo, 0, sizeof(*pBankInfo));
-+
-+    if((NULL == pBankInfo) || (bankNum >= MV_DRAM_MAX_CS ))
