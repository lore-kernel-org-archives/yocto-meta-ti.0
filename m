-+	pix->pixelformat = formats[i].pixelformat;
-+	pix->bytesperline = bpl;
-+	pix->sizeimage = pix->bytesperline * pix->height;
-+	pix->colorspace = mbus->colorspace;
-+	pix->field = mbus->field;
-+
-+	return bpl - min_bpl;
