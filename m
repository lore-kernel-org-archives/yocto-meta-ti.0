-+		while (index + 1 < FM_RX_RDS_INFO_FIELD_MAX) {
-+			byte1 = rds_buff[index];
-+			rds_buff[index] = rds_buff[index + 1];
-+			rds_buff[index + 1] = byte1;
-+			index += 2;
-+		}
-+	}
