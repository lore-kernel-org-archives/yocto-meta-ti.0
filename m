++	ks->tx_space = ks8851_rdreg16(ks, KS_TXMIR);
++	if (ks->tx_space > ks->tx_len)
++		netif_wake_queue(ks->netdev);
++	else
++		schedule_work(&ks->tx_check);
++}
++
