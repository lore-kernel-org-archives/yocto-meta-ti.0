-+ * Returns in *max_rate less value between calculated and passed
-+ */
-+void omap3isp_ccdc_max_rate(struct isp_ccdc_device *ccdc,
-+			    unsigned int *max_rate)
-+{
-+	struct isp_pipeline *pipe = to_isp_pipeline(&ccdc->subdev.entity);
-+	unsigned int rate;
