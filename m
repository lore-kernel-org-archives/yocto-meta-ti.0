-+++ b/arch/arm/mach-omap2/cminst44xx.c
-@@ -309,3 +309,43 @@ int omap4_cminst_wait_module_idle(u8 part, u16 inst, s16 cdoffs, u16 clkctrl_off
- 
- 	return (i < MAX_MODULE_READY_TIME) ? 0 : -EBUSY;
- }
