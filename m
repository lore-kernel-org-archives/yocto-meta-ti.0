-+	    <entry>__u32</entry>
-+	    <entry><structfield>reserved</structfield>[8]</entry>
-+	    <entry>Reserved for future extensions. Applications and drivers must
-+	    set the array to zero.</entry>
-+	  </row>
-+	</tbody>
-+      </tgroup>
-+    </table>
-+
-+    <table pgwide="1" frame="none" id="v4l2-subdev-format-whence">
