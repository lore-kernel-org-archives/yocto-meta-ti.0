-+static int ccdc_enum_mbus_code(struct v4l2_subdev *sd,
-+			       struct v4l2_subdev_fh *fh,
-+			       struct v4l2_subdev_mbus_code_enum *code)
-+{
-+	struct isp_ccdc_device *ccdc = v4l2_get_subdevdata(sd);
