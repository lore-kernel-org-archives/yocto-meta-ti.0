- 			page_cache_release(page);
- 		}
- 	}
-+	cifs_kmap_unlock();
- 
- 	/* issue the read if we have any iovecs left to fill */
- 	if (rdata->nr_iov > 1) {
-@@ -2171,6 +2199,7 @@ cifs_async_writev(struct cifs_writedata *wdata)
