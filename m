+@@ -754,6 +740,17 @@ static void ks8851_done_tx(struct ks8851_net *ks, struct sk_buff *txb)
+ 	dev_kfree_skb(txb);
+ }
+ 
++static void ks8851_tx_check(struct work_struct *work)
++{
++	struct ks8851_net *ks = container_of(work, struct ks8851_net, tx_check);
