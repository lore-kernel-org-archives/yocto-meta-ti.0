-+		for (chan = 0; chan < MV_XOR_MAX_CHAN_PER_UNIT; chan++)
-+		{
-+		    MV_REG_BIT_RESET(XOR_WINDOW_CTRL_REG(unit,chan),
-+							 XEXWCR_WIN_EN_MASK(winNum));
-+		}
-+
-+	}
-+
-+	return MV_OK;
