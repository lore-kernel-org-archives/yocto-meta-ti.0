-+
-+	/* Read pci mode register */
-+	pciMode = MV_REG_READ(PCI_MODE_REG(pciIf));
-+
-+	switch (pciMode & PMR_PCI_MODE_MASK)
-+	{
-+		case PMR_PCI_MODE_CONV:
-+            pPciMode->pciType  = MV_PCI_CONV;
-+
-+			if (MV_REG_READ(PCI_DLL_CTRL_REG(pciIf)) & PDC_DLL_EN)
