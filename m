-index b980ecd..4fc4dbb 100644
---- a/fs/bio.c
-+++ b/fs/bio.c
-@@ -505,9 +505,14 @@ EXPORT_SYMBOL(bio_clone);
- int bio_get_nr_vecs(struct block_device *bdev)
- {
- 	struct request_queue *q = bdev_get_queue(bdev);
--	return min_t(unsigned,
