-+static struct gpio_bank *gpio_bank = &gpio_bank_44xx[0];
-+
-+static inline struct gpio_bank *get_gpio_bank(int gpio)
-+{
-+	return &gpio_bank[gpio >> 5];
-+}
-+
-+static inline int get_gpio_index(int gpio)
