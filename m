- 	 * reference and switch to it.
-@@ -310,6 +308,8 @@ asmlinkage void __cpuinit secondary_start_kernel(void)
- 	enter_lazy_tlb(mm, current);
- 	local_flush_tlb_all();
- 
-+	printk("CPU%u: Booted secondary processor\n", cpu);
-+
