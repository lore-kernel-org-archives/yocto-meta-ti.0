-+                       OMAP3430_GR_MOD,
-+                       OMAP3_PRM_LDO_ABB_CTRL_OFFSET);
-+
-+       /* program settling time of 30us for ABB ldo transition */
-+       omap2_prm_rmw_mod_reg_bits(OMAP3630_SR2_WTCNT_VALUE_MASK,
-+                       (0x62 << OMAP3630_SR2_WTCNT_VALUE_SHIFT),
-+                       OMAP3430_GR_MOD,
-+                       OMAP3_PRM_LDO_ABB_CTRL_OFFSET);
