-+
-+    for(i = 0; i < MV_MAC_ADDR_SIZE; i++)
-+    {
-+        mvOsSPrintf(&macStr[i * 3], "%02x:", macHex[i]);
-+    }
-+    macStr[(i * 3) - 1] = '\0';
-+
-+    return MV_OK;
-+}
