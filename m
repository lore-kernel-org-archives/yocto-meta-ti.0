--			portstate(musb->port1_status |= USB_PORT_STAT_POWER);
--			del_timer(&otg_workaround);
-+			if (!(devctl & MUSB_DEVCTL_SESSION) ||
-+			   (devctl & MUSB_DEVCTL_BDEVICE) ||
-+			   (devctl & MUSB_DEVCTL_HM)) {
-+				if (musb->is_active)
