-+			continue;
-+		}
-+
-+		/* first get attributes from CPU If */
-+		if (MV_OK != status)
-+		{
-+			mvOsPrintf("mvPexInit: ERR. mvCpuIfTargetWinGet failed target =%d\n",target);
