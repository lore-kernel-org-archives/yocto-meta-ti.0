-+*
-+* OUTPUT:
-+*       None.
-+*
-+* EXAMPLE:
-+*       Get GPP8 and GPP15 value.
-+*       mvGppValueGet(0, (GPP8 | GPP15));
-+*
-+* RETURN:
-+*       32bit value that describes GPP activity mode per pin.
-+*
-+*******************************************************************************/
-+MV_U32 mvGppValueGet(MV_U32 group, MV_U32 mask)
-+{
-+	MV_U32 gppData;
-+
-+	gppData = MV_REG_READ(GPP_DATA_IN_REG(group));
-+
-+	gppData &= mask;
-+
-+	return gppData;
-+
-+}
