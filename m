-+	for (i = 0; i < ARRAY_SIZE(mt9t112_cfmts); i++)
-+		if (mt9t112_cfmts[i].code == code)
-+			break;
-+
-+	if (i == ARRAY_SIZE(mt9t112_cfmts))
-+		return -EINVAL;
-+
-+	priv->frame.width  = (u16)width;
-+	priv->frame.height = (u16)height;
-+
-+	priv->format = mt9t112_cfmts + i;
-+
-+	return 0;
