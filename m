-+*******************************************************************************/
-+static MV_STATUS pexBarIsValid(MV_U32 baseLow, MV_U32 size)
-+{
-+
-+	/* PCI spec restrict BAR base to be aligned to BAR size					*/
-+	if(MV_IS_NOT_ALIGN(baseLow, size))
-+	{
-+		return MV_ERROR;
-+	}
-+	else
-+	{
-+		return MV_TRUE;
-+	}
-+
-+	return MV_TRUE;
