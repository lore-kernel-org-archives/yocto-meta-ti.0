++		if (per_dev->cur_sg >= ios->sgs_per_dev) {
++			ORE_DBGMSG("cur_sg(%d) >= sgs_per_dev(%d)\n" ,
++				per_dev->cur_sg, ios->sgs_per_dev);
++			return -ENOMEM;
++		}
+ 		_ore_add_sg_seg(per_dev, cur_len, true);
