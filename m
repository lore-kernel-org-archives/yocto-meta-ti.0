-+		mvOsPrintf("TWSI: twsiAddr10BitSet ERROR - status %x 2nd addr(10 Bit) in %s mode.\n"\
-+						,val, ((command==MV_TWSI_WRITE)?"Write":"Read") );
-+		return MV_FAIL;
-+	}
-+
-+	return MV_OK;
-+}
