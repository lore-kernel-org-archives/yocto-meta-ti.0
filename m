-+				       struct isp_buffer, buffer.irqlist);
-+		video->ops->queue(video, buf);
-+		video->dmaqueue_flags |= ISP_VIDEO_DMAQUEUE_QUEUED;
-+	} else {
-+		if (continuous)
-+			video->dmaqueue_flags |= ISP_VIDEO_DMAQUEUE_UNDERRUN;
-+	}
-+}
