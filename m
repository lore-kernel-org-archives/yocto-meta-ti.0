-+    pTxCurrDesc->cmdSts = pPktInfo->status              |
-+                          ETH_BUFFER_OWNED_BY_DMA       |
-+                          ETH_TX_GENERATE_CRC_MASK      |
-+                          ETH_TX_ENABLE_INTERRUPT_MASK  |
-+                          ETH_TX_ZERO_PADDING_MASK      |
-+                          ETH_TX_FIRST_DESC_MASK        |
